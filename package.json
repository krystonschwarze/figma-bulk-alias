{
  "name": "figma-bulk-alias",
  "version": "1.1.0",
  "private": true,
  "description": "Figma plugin that aliases a whole group of variables onto another group, matched by name.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs --minify",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:ui-kit": "node scripts/sync-ui-kit.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.136.0",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
